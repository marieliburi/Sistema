<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGUScola - Portal</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js"></script>
</head>
<body>

  <%- include('partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('partials/header') %>

    <section class="content-banner">
      <div class="welcome-header">
        <h1>Olá <%= usuario.nome %>!</h1>
        <p>Seja bem vindo de volta!</p>
      </div>

      <div class="action-bar">
        <div class="pills-container">
          <a href="/" class="btn-pill">INÍCIO</a>
          <a href="/portal" class="btn-pill active">PORTAL</a>
        </div>
        <a href="javascript:history.back()" class="btn-voltar">&lt; VOLTAR</a>
      </div>
    </section>

    <main class="content-body">
      <div class="cards-grid">
        <a href="#" class="card">
          <i class="fa-solid fa-people-roof"></i>
          <span>PORTAL DOS PAIS</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-laptop-code"></i>
          <span>PORTAL DO ALUNO</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-bullhorn"></i>
          <span>MURAL DE AVISOS</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-comments"></i>
          <span>OUVIDORIA ESCOLAR</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-calendar-days"></i>
          <span>CALENDÁRIO DE EVENTOS</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-print"></i>
          <span>SECRETARIA ONLINE</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-book-atlas"></i>
          <span>BIBLIOTECA VIRTUAL</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-photo-film"></i>
          <span>GALERIA DE PROJETOS</span>
        </a>
      </div>
    </main>

    <footer class="footer">
      <div><strong>SIGUEscola</strong></div>
      <div><strong>Contato:</strong> suporteadm@smeourinhos.sp.gov.br</div>
    </footer>
  </div>

</body>
</html>
