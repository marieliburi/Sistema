<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGUScola - Infraestrutura</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js"></script>
</head>
<body>

  <%- include('partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('partials/header') %>

    <section class="content-banner">
      <div class="welcome-header">
        <h1>Olá <%= usuario.nome %>!</h1>
        <p>Seja bem vindo de volta!</p>
      </div>

      <div class="action-bar">
        <div class="pills-container">
          <a href="/" class="btn-pill">INÍCIO</a>
          <a href="/infraestrutura" class="btn-pill active">INFRAESTRUTURA</a>
        </div>
        <a href="javascript:history.back()" class="btn-voltar">&lt; VOLTAR</a>
      </div>
    </section>

    <main class="content-body">
      <div class="cards-grid">
        <a href="#" class="card">
          <i class="fa-solid fa-door-open"></i>
          <span>GESTÃO DE SALAS</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-flask-vial"></i>
          <span>LABORATÓRIOS E BIBLIOTECAS</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-toolbox"></i>
          <span>MANUTENÇÃO PREDIAL</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-boxes-stacked"></i>
          <span>PATRIMÔNIO E BENS</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-bus"></i>
          <span>TRANSPORTE ESCOLAR</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-utensils"></i>
          <span>ALIMENTAÇÃO E MERENDA</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-network-wired"></i>
          <span>EQUIPAMENTOS DE TI</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-shield-halved"></i>
          <span>SEGURANÇA E ACESSO</span>
        </a>
      </div>
    </main>

    <footer class="footer">
      <div><strong>SIGUEscola</strong></div>
      <div><strong>Contato:</strong> suporteadm@smeourinhos.sp.gov.br</div>
    </footer>
  </div>

</body>
</html>
