<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGUEscola - Professor</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js"></script>
</head>
<body>

  <%- include('partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('partials/header') %>

    <section class="content-banner">
      <div class="welcome-header">
        <h1>Olá <%= usuario.nome %>!</h1>
        <p>Seja bem vindo de volta!</p>
      </div>

      <div class="action-bar">
        <div class="pills-container">
          <a href="/" class="btn-pill">INÍCIO</a>
          <a href="/professor" class="btn-pill active">PROFESSOR</a>
        </div>
        <a href="javascript:history.back()" class="btn-voltar">&lt; VOLTAR</a>
      </div>
    </section>

    <main class="content-body">
      <div class="cards-grid">
        <a href="#" class="card">
          <i class="fa-solid fa-book-open"></i>
          <span>PLANO DE ENSINO</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-book-open-reader"></i>
          <span>DIÁRIO DE CLASSE</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-users-rectangle"></i>
          <span>CONSELHO DE CLASSE</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-chart-column"></i>
          <span>SONDAGEM</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-hands-holding-child"></i>
          <span>AEE</span>
        </a>
      </div>
    </main>

    <%- include('partials/footer') %>
  </div>

</body>
</html>