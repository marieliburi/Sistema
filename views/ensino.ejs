<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGUEscola - Sistema de Ensino</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js"></script>
</head>
<body>

  <%- include('partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('partials/header') %>

    <section class="content-banner">
      <div class="welcome-header">
        <h1>Olá <%= usuario.nome %>!</h1>
        <p>Seja bem vindo de volta!</p>
      </div>

      <div class="action-bar">
        <div class="pills-container">
          <a href="/" class="btn-pill">INÍCIO</a>
          <a href="/ensino" class="btn-pill active">SISTEMA DE ENSINO</a>
        </div>
        <a href="javascript:history.back()" class="btn-voltar">&lt; VOLTAR</a>
      </div>
    </section>

    <main class="content-body">
      <div class="cards-grid">
        <a href="#" class="card">
          <i class="fa-solid fa-layer-group"></i>
          <span>CURSO E MODALIDADE</span>
        </a>
        <a href="#" class="card">
          <i class="fa-regular fa-calendar-days"></i>
          <span>CALENDÁRIO</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-sitemap"></i>
          <span>ORGANIZAÇÃO CURRICULAR</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-school"></i>
          <span>UNIDADE ESCOLAR</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-star"></i>
          <span>EVENTOS SME</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-magnifying-glass-chart"></i>
          <span>PESQUISAS</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-file-circle-check"></i>
          <span>INSCRIÇÕES</span>
        </a>
      </div>
    </main>

    <%- include('partials/footer') %>
  </div>

</body>
</html>
