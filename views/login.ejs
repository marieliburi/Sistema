<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGUScola - Autenticação</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js"></script>
</head>
<body class="login-body">

  <div class="login-container">
    <div class="login-card">
      <div class="login-header">
        <div class="login-logo-circle">
          <i class="fa-solid fa-graduation-cap"></i>
        </div>
        <h1>SIGUScola</h1>
        <p>Sistema Integrado de Gestão Educacional</p>
      </div>

      <% if (typeof erro !== 'undefined' && erro) { %>
        <div class="login-alert">
          <i class="fa-solid fa-circle-exclamation"></i>
          <span><%= erro %></span>
        </div>
      <% } %>

      <form action="/login" method="POST">
        <div class="form-group">
          <label for="email">E-mail de Acesso</label>
          <div class="input-icon-wrapper">
            <i class="fa-regular fa-envelope"></i>
            <input 
              type="email" 
              id="email" 
              name="email" 
              class="login-input" 
              placeholder="Digite seu e-mail" 
              value="<%= typeof emailAnterior !== 'undefined' ? emailAnterior : '' %>"
              required 
              autofocus
            >
          </div>
        </div>

        <div class="form-group">
          <label for="senha">Senha</label>
          <div class="input-icon-wrapper">
            <i class="fa-solid fa-lock"></i>
            <input 
              type="password" 
              id="senha" 
              name="senha" 
              class="login-input" 
              placeholder="Digite sua senha" 
              required
            >
          </div>
        </div>

        <button type="submit" class="login-btn">
          <i class="fa-solid fa-right-to-bracket" style="margin-right: 8px;"></i>
          ENTRAR NO SISTEMA
        </button>
      </form>

      <div class="login-demo-box">
        <strong><i class="fa-solid fa-circle-info"></i> Acesso Demonstrativo:</strong>
        <div>• <b>Administrador:</b> marieliburi@email.com | senha123</div>
        <div>• <b>Professor:</b> professor@email.com | prof123</div>
      </div>
    </div>
  </div>

</body>
</html>
