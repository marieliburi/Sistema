<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGUScola - Integração</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js"></script>
</head>
<body>

  <%- include('partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('partials/header') %>

    <section class="content-banner">
      <div class="welcome-header">
        <h1>Olá <%= usuario.nome %>!</h1>
        <p>Seja bem vindo de volta!</p>
      </div>

      <div class="action-bar">
        <div class="pills-container">
          <a href="/" class="btn-pill">INÍCIO</a>
          <a href="/integracao" class="btn-pill active">INTEGRAÇÃO</a>
        </div>
        <a href="javascript:history.back()" class="btn-voltar">&lt; VOLTAR</a>
      </div>
    </section>

    <main class="content-body">
      <div class="cards-grid">
        <a href="#" class="card">
          <i class="fa-solid fa-landmark"></i>
          <span>CENSO ESCOLAR / MEC</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-globe"></i>
          <span>SED - SECRETARIA DIGITAL</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-code"></i>
          <span>APIS E WEBHOOKS</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-file-import"></i>
          <span>IMPORTAÇÃO / EXPORTAÇÃO</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-key"></i>
          <span>AUTENTICAÇÃO GOV.BR</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-comment-dots"></i>
          <span>MENSAGERIA / SMS</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-book"></i>
          <span>SISTEMA BIBLIOTECA</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-server"></i>
          <span>LOGS DE SINCRONIZAÇÃO</span>
        </a>
      </div>
    </main>

    <footer class="footer">
      <div><strong>SIGUEscola</strong></div>
      <div><strong>Contato:</strong> suporteadm@smeourinhos.sp.gov.br</div>
    </footer>
  </div>

</body>
</html>
