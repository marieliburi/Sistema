<header class="topbar">
  <div class="topbar-icons">
    <i class="fa-solid fa-bars"></i>
    <a href="/personalizacao" class="topbar-icon-link" title="Personalização do Sistema">
      <i class="fa-regular fa-lightbulb"></i>
    </a>
    <i class="fa-solid fa-paint-brush"></i>
    <i class="fa-regular fa-file"></i>
  </div>
  <div class="user-profile">
    <i class="fa-regular fa-bell"></i>
    <a href="/perfil" class="user-link" title="Acessar Meu Perfil">
      <i class="fa-regular fa-user-circle" style="font-size: 20px;"></i>
      <span>Olá, <%= usuario.nome %>!</span>
    </a>
    <a href="/logout" class="logout-btn-link" title="Sair do Sistema">
      <i class="fa-solid fa-right-from-bracket logout-btn"></i>
    </a>
  </div>
</header>