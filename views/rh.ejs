<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGUScola - Recursos Humanos</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js"></script>
</head>
<body>

  <%- include('partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('partials/header') %>

    <section class="content-banner">
      <div class="welcome-header">
        <h1>Olá <%= usuario.nome %>!</h1>
        <p>Seja bem vindo de volta!</p>
      </div>

      <div class="action-bar">
        <div class="pills-container">
          <a href="/" class="btn-pill">INÍCIO</a>
          <a href="/rh" class="btn-pill active">RECURSOS HUMANOS</a>
        </div>
        <a href="javascript:history.back()" class="btn-voltar">&lt; VOLTAR</a>
      </div>
    </section>

    <main class="content-body">
      <div class="cards-grid">
        <a href="#" class="card">
          <i class="fa-solid fa-user-tie"></i>
          <span>QUADRO DE SERVIDORES</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-chalkboard"></i>
          <span>ATRIBUIÇÃO DE AULAS</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-clock"></i>
          <span>CONTROLE DE PONTO</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-file-invoice-dollar"></i>
          <span>FOLHA DE PAGAMENTO</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-umbrella-beach"></i>
          <span>FÉRIAS E LICENÇAS</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-user-graduate"></i>
          <span>CAPACITAÇÃO E FORMAÇÃO</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-file-signature"></i>
          <span>CONCURSOS E PROCESSOS</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-chart-pie"></i>
          <span>AVALIAÇÃO DE DESEMPENHO</span>
        </a>
      </div>
    </main>

    <footer class="footer">
      <div><strong>SIGUEscola</strong></div>
      <div><strong>Contato:</strong> suporteadm@smeourinhos.sp.gov.br</div>
    </footer>
  </div>

</body>
</html>
