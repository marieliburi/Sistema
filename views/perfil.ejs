<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGUEscola - Meu Perfil</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js"></script>
</head>
<body>

  <%- include('partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('partials/header') %>

    <main class="profile-container">
      <h1 class="profile-title">Meu Perfil</h1>

      <!-- Card do Perfil -->
      <div class="profile-card">
        <button type="button" id="btnEditar" class="btn-editar-perfil">
          <i class="fa-solid fa-pen"></i> Editar
        </button>

        <div class="profile-avatar-wrapper">
          <% if (usuario.fotoUrl) { %>
            <img 
              src="<%= usuario.fotoUrl %>" 
              alt="Foto de Perfil" 
              class="profile-avatar-img"
              onerror="this.onerror=null; this.src='/images/foto-perfil1.png';"
            >
          <% } else { %>
            <img 
              src="/images/foto-perfil1.png" 
              alt="Foto de Perfil Padrão" 
              class="profile-avatar-img"
              onerror="this.style.display='none'; document.getElementById('avatar-fallback-icon').style.display='flex';"
            >
            <div id="avatar-fallback-icon" class="profile-avatar-placeholder" style="display: none;">
              <i class="fa-solid fa-user" style="color: #1a56a3; font-size: 80px;"></i>
            </div>
          <% } %>

          <button class="profile-camera-btn" title="Alterar Foto">
            <i class="fa-solid fa-camera"></i>
          </button>
        </div>

        <div class="profile-info">
          <h2 id="displayNome"><%= usuario.nomeCompleto %></h2>
          
          <div class="profile-badge">
            <i class="fa-solid fa-user"></i>
            <span><%= usuario.cargo %></span>
          </div>

          <div class="profile-detail">
            <i class="fa-regular fa-envelope"></i>
            <span id="displayEmail"><%= usuario.email %></span>
          </div>

          <div class="profile-detail">
            <i class="fa-solid fa-phone"></i>
            <span id="displayTelefone"><%= usuario.telefone %></span>
          </div>
        </div>
      </div>

      <!-- Formulário de Edição (Inicialmente oculto) -->
      <form id="formEditarPerfil" class="profile-edit-card" style="display: none;" action="/perfil/editar" method="POST">
        <div class="form-group">
          <label for="inputNome">Nome:</label>
          <input type="text" id="inputNome" name="nomeCompleto" value="<%= usuario.nomeCompleto %>" placeholder="Digite seu texto aqui:" required>
        </div>

        <div class="form-group">
          <label for="inputEmail">Email:</label>
          <input type="email" id="inputEmail" name="email" value="<%= usuario.email %>" placeholder="Digite seu texto aqui:" required>
        </div>

        <div class="form-group">
          <label for="inputTelefone">Telefone:</label>
          <input type="text" id="inputTelefone" name="telefone" value="<%= usuario.telefone %>" placeholder="Digite seu texto aqui:">
        </div>

        <div class="form-actions-inline">
          <button type="submit" class="btn-salvar-perfil">SALVAR</button>
          <button type="button" id="btnCancelar" class="btn-cancelar-perfil">CANCELAR</button>
        </div>
      </form>

      <!-- Ações Inferiores -->
      <div class="profile-actions">
        <a href="javascript:history.back()" class="btn-voltar">&lt; VOLTAR</a>
      </div>
    </main>

    <%- include('partials/footer') %>
  </div>

  <!-- Script para Alternar Modo de Edição -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btnEditar = document.getElementById('btnEditar');
      const btnCancelar = document.getElementById('btnCancelar');
      const formEditar = document.getElementById('formEditarPerfil');

      btnEditar.addEventListener('click', () => {
        formEditar.style.display = 'block';
        formEditar.scrollIntoView({ behavior: 'smooth' });
      });

      btnCancelar.addEventListener('click', () => {
        formEditar.style.display = 'none';
      });
    });
  </script>
</body>
</html>