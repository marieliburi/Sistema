<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGUScola - Sistema</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js"></script>
</head>
<body>

  <%- include('partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('partials/header') %>

    <section class="content-banner">
      <div class="welcome-header">
        <h1>Olá <%= usuario.nome %>!</h1>
        <p>Seja bem vindo de volta!</p>
      </div>

      <div class="action-bar">
        <div class="pills-container">
          <a href="/" class="btn-pill">INÍCIO</a>
          <a href="/sistema" class="btn-pill active">SISTEMA</a>
        </div>
        <a href="/" class="btn-voltar">&lt; VOLTAR</a>
      </div>
    </section>

    <main class="content-body">
      <div class="cards-grid">
        <a href="#" class="card">
          <i class="fa-solid fa-gears"></i>
          <span>DESENVOLVIMENTO E PROGRAMAÇÃO</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-user"></i>
          <span>USUÁRIOS</span>
        </a>
        <a href="#" class="card">
          <i class="fa-regular fa-copy"></i>
          <span>AUDITORIA</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-file-signature"></i>
          <span>DOCUMENTOS</span>
        </a>
      </div>
    </main>

    <footer class="footer">
      <div><strong>SIGUEscola</strong></div>
      <div><strong>Contato:</strong> suporteadm@smeourinhos.sp.gov.br</div>
    </footer>
  </div>

</body>
</html>