<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGUScola - Aluno</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js"></script>
</head>
<body>

  <%- include('partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('partials/header') %>

    <section class="content-banner">
      <div class="welcome-header">
        <h1>Olá <%= usuario.nome %>!</h1>
        <p>Seja bem vindo de volta!</p>
      </div>

      <div class="action-bar">
        <div class="pills-container">
          <a href="/" class="btn-pill">INÍCIO</a>
          <a href="/aluno" class="btn-pill active">ALUNO</a>
        </div>
        <a href="javascript:history.back()" class="btn-voltar">&lt; VOLTAR</a>
      </div>
    </section>

    <main class="content-body">
      <div class="cards-grid">
        <a href="#" class="card">
          <i class="fa-solid fa-id-card"></i>
          <span>MATRÍCULAS E REMATRÍCULAS</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-graduation-cap"></i>
          <span>HISTÓRICO ESCOLAR</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-square-poll-vertical"></i>
          <span>BOLETIM E NOTAS</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-user-check"></i>
          <span>FREQUÊNCIA ESCOLAR</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-folder-open"></i>
          <span>DOCUMENTAÇÃO</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-clipboard-list"></i>
          <span>OCORRÊNCIAS DISCIPLINARES</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-address-card"></i>
          <span>CARTEIRINHA ESTUDANTIL</span>
        </a>
        <a href="#" class="card">
          <i class="fa-solid fa-arrow-right-arrow-left"></i>
          <span>TRANSFERÊNCIAS</span>
        </a>
      </div>
    </main>

    <footer class="footer">
      <div><strong>SIGUEscola</strong></div>
      <div><strong>Contato:</strong> suporteadm@smeourinhos.sp.gov.br</div>
    </footer>
  </div>

</body>
</html>